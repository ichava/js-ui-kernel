{
  "name": "@ichava/js-ui-kernel",
  "version": "0.1.2",
  "description": "Framework-agnostic domain kernel and shared TypeScript configuration for the Ichava UI packages.",
  "license": "MIT",
  "author": "Simtabi LLC <opensource@simtabi.com> (https://simtabi.com)",
  "homepage": "https://github.com/ichava/js-ui-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichava/js-ui-kernel.git"
  },
  "bugs": {
    "url": "https://github.com/ichava/js-ui-kernel/issues"
  },
  "keywords": [
    "ichava",
    "icons",
    "kernel",
    "typescript",
    "framework-agnostic"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/token-scope.d.ts",
      "import": "./dist/build/token-scope.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:config-drift": "node config/check-config-drift.mjs config/tsconfig.base.json=config/tsconfig.base.json config/eslint.base.js=config/eslint.base.js config/check-config-drift.mjs=config/check-config-drift.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  }
}
